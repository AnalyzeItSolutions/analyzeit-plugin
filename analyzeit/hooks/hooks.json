{
  "description": "AnalyzeIt memory across sessions: recall what is known about this folder when a session starts; with auto-save on (analyzeit memory autosave on), keep a short note when a session is compacted or ends. Every hook stays silent and never blocks when you are signed out, offline, or on an older analyzeit. Before each message, a data question about a dataset you shared is answered on your computer (computed results only) and added as context, so the assistant answers in one step without reading the file. A message about the project's code gets the files that hold its wording (or the answer, for \"where is X defined\"), and the times the assistant still has to search the code itself are recorded for `analyzeit misses`.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "analyzeit memory hook session-start 2>/dev/null || true",
            "timeout": 12
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/prompt-hook.sh\" notice 2>/dev/null || true",
            "timeout": 12
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "analyzeit memory hook pre-compact 2>/dev/null || true",
            "timeout": 45
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "analyzeit memory hook session-end 2>/dev/null || true",
            "timeout": 45
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/prompt-hook.sh\" prompt 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|shell|exec_command|local_shell|read_file",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/prompt-hook.sh\" tool 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/prompt-hook.sh\" stop 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
